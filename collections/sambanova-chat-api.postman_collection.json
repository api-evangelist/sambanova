  "info": {
    "_postman_id": "61315f67-59e0-4f46-b8f0-46600485ada4",
    "name": "SambaCloud Chat API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "SambaCloud is SambaNova's managed inference API for open-source models\n(DeepSeek, Llama, Gemma, MiniMax, gpt-oss). The HTTP surface is\nOpenAI-compatible: chat completions, completions, embeddings, and\nmodel listing endpoints all match the OpenAI shape so existing OpenAI\nclients can be pointed at `https://api.sambanova.ai/v1` by changing\nbase URL and API key.\n\n\nContact Support:\n Name: SambaNova",
      "type": "text/plain"
    }
  }
